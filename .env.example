# Ejemplo de variables de entorno. Copia a .env.local y completa.
# NUNCA commits secretos reales.

# Directorio de datos locales (opcional; por defecto ./data)
COMPANERO_DATA_DIR=

# Si usas un proveedor OpenAI-compatible que exige clave,
# referencia el nombre en Configuración → apiKeyEnv, p. ej.:
COMPANERO_MODEL_API_KEY=

# Continuidad remota (futuro; no sincroniza secretos)
COMPANERO_REMOTE_ENDPOINT=
COMPANERO_REMOTE_TOKEN=
